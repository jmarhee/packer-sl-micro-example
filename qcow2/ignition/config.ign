{
  "ignition": {
    "version": "3.4.0"
  },
  "passwd": {
    "users": [
      {
        "name": "root",
        "sshAuthorizedKeys": [
          "ssh-rsa  jmarhee@iampizza-2.local"
        ]
      }
    ]
  },
  "storage": {
    "files": [
      {
        "overwrite": true,
        "path": "/etc/ssh/sshd_config.d/00-disable-password-auth.conf",
        "mode": 420,
        "contents": {
          "source": "data:text/plain;base64,"
        }
      },
      {
        "overwrite": true,
        "path": "/etc/packer-bake-pending",
        "mode": 384,
        "contents": {
          "source": "data:,"
        }
      }
    ]
  },
  "systemd": {
    "units": [
      {
        "enabled": true,
        "name": "sshd.service"
      },
      {
        "enabled": true,
        "name": "packer-poweroff.service",
        "contents": "[Unit]\nDescription=Power off once after Packer bake\nAfter=multi-user.target\nConditionPathExists=/etc/packer-bake-pending\n\n[Service]\nType=oneshot\nExecStart=/bin/rm -f /etc/packer-bake-pending\nExecStart=/usr/sbin/poweroff\n\n[Install]\nWantedBy=multi-user.target\n"
      }
    ]
  }
}
